# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYSTACK CONFIGURATION (Test Mode)
# Public key used by the Member App Paystack inline checkout
VITE_PAYSTACK_PUBLIC_KEY="pk_test_piset_port_harcourt_demo_key"
# Secret key used by the Cloud Function / Server Webhook to verify x-paystack-signature (HMAC SHA-512)
PAYSTACK_SECRET_KEY="sk_test_piset_port_harcourt_secret_key"

# SMS / WHATSAPP REMINDER PROVIDER (Termii / Africa's Talking / Twilio)
SMS_PROVIDER_API_KEY="your_sms_provider_api_key_here"
SMS_SENDER_ID="PISETCOOP"
WHATSAPP_BUSINESS_TOKEN="your_whatsapp_business_token_here"
